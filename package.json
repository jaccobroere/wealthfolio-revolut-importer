{
  "name": "wealthfolio-revolut-importer",
  "version": "0.1.0",
  "type": "module",
  "description": "Import Revolut investment CSV statements into Wealthfolio",
  "author": "Jacco Broere",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "main": "dist/addon.js",
  "keywords": [
    "wealthfolio",
    "revolut",
    "importer",
    "addon",
    "finance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jaccobroere/wealthfolio-revolut-importer.git"
  },
  "homepage": "https://github.com/jaccobroere/wealthfolio-revolut-importer#readme",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio dev",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect:csv": "tsx scripts/inspect-csv.ts",
    "acceptance:local": "vitest run -c vitest.acceptance.config.ts",
    "check:fixtures": "tsx scripts/check-fixtures.ts",
    "validate:manifest": "tsx scripts/validate-manifest.ts",
    "package:addon": "sh scripts/package-addon.sh",
    "validate:package": "tsx scripts/validate-package.ts",
    "privacy:scan": "sh scripts/privacy-scan.sh",
    "release:attestation": "tsx scripts/write-release-attestation.ts",
    "integration:revolut": "playwright test",
    "verify": "pnpm format && pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm check:fixtures && pnpm privacy:scan && pnpm validate:manifest && pnpm package:addon && pnpm validate:package",
    "verify:release": "sh scripts/verify-release.sh"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "papaparse": "5.5.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.6.0",
    "@wealthfolio/ui": "^3.6.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.90.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@wealthfolio/addon-dev-tools": "^3.6.0",
    "@wealthfolio/addon-sdk": "^3.6.0",
    "@wealthfolio/ui": "^3.6.0",
    "date-fns": "^4.1.0",
    "decimal.js": "10.6.0",
    "eslint": "^9.18.0",
    "fast-check": "^3.19.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.561.0",
    "papaparse": "5.5.4",
    "prettier": "^3.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.0"
  }
}
