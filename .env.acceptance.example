# Local acceptance-test statement path.
# Copy this file to `.env` (gitignored) and set the absolute path to your real
# Revolut investment CSV export. The acceptance suite (pnpm acceptance:local)
# reads ONLY this variable and never copies the file into the repository.
#
# Env var: REVOLUT_ACCEPTANCE_CSV
# Example:
#   REVOLUT_ACCEPTANCE_CSV=/absolute/path/to/your/revolut-statement.csv
REVOLUT_ACCEPTANCE_CSV=/absolute/path/to/your/revolut-statement.csv
REVOLUT_ACCEPTANCE_BASELINE=/absolute/path/to/.local/acceptance-baseline.json
